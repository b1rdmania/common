PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
APP_NAME=Common
APP_CITY=East London
APP_TIMEZONE=Europe/London
DATABASE_PATH=./data/common.sqlite
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The isolated local demo is started with npm run demo. Leave this off for real use.
DEMO_MODE=false
# Optional SMTP. Without it, updates remain visible in My plans / Host dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Common <hello@example.org>
